{
    "layer": "top",
    "position": "top",
    "height": 34,
    "spacing": 8,

    "modules-left": ["hyprland/workspaces", "hyprland/window"],
    "modules-center": ["clock"],
    "modules-right": ["custom/dropbox", "tray", "pulseaudio", "network", "cpu", "memory"],

    "hyprland/workspaces": {
        "format": "{name}",
        "on-click": "activate",
        "on-scroll-up": "hyprctl dispatch workspace m-1",
        "on-scroll-down": "hyprctl dispatch workspace m+1",
        "persistent-workspaces": {
            "DP-1": [1, 2],
            "HDMI-A-1": [3, 4]
        }
    },

    "clock": {
        "format": "{:%a %b %d  %I:%M %p}",
        "format-alt": "{:%A, %B %d, %Y  %I:%M:%S %p}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            "weeks-pos": "right",
            "on-scroll": 1,
            "format": {
                "months": "<span color='#89b4fa'><b>{}</b></span>",
                "weekdays": "<span color='#f9e2af'><b>{}</b></span>",
                "weeks": "<span color='#6c7086'>W{}</span>",
                "today": "<span color='#89b4fa' background='#313244'><b><u>{}</u></b></span>"
            }
        }
    },

    "hyprland/window": {
        "format": "{class}",
        "max-length": 50,
        "separate-outputs": true,
        "rewrite": {
            "kitty": " Kitty",
            "firefox": " Firefox",
            "chromium": " Chromium",
            "discord": "󰙯 Discord",
            "vesktop": "󰙯 Vesktop",
            "spotify": " Spotify",
            "code": "󰨞 Code",
            "thunar": " Files",
            "steam": " Steam",
            "obsidian": "󱓧 Obsidian",
            "unity": "󰛓 Unity",
            "blender": "󰂫 Blender",
            "(.*)": "$1"
        }
    },

    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-muted": "  muted",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", "", ""]
        },
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-click-right": "pavucontrol",
        "scroll-step": 5
    },

    "network": {
        "interval": 2,
        "format-ethernet": "  {ipaddr}  ↓{bandwidthDownBits} ↑{bandwidthUpBits}",
        "format-wifi": "  {signalStrength}%",
        "format-disconnected": "  disconnected",
        "tooltip-format": "{ifname}: {ipaddr}/{cidr}\n{bandwidthUpBits} up / {bandwidthDownBits} down"
    },

    "cpu": {
        "format": "  {usage}%",
        "interval": 1,
        "on-click": "kitty -e btop"
    },

    "memory": {
        "format": "  {percentage}%",
        "interval": 2,
        "on-click": "kitty -e btop",
        "tooltip-format": "{used:0.1f}G / {total:0.1f}G"
    },

    "custom/dropbox": {
        "exec": "~/.config/waybar/scripts/dropbox-status.sh",
        "return-type": "json",
        "interval": 10,
        "on-click": "kitty -e yazi ~/Dropbox",
        "on-click-right": "systemctl --user restart rclone-dropbox.service"
    },

    "tray": {
        "icon-size": 16,
        "spacing": 8
    }
}
