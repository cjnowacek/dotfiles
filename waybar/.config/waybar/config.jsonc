{
    // Shared bar for both machines. The per-host part is only what hardware
    // dictates: "modules-right" and "hyprland/workspaces" live in host.jsonc
    // (a bootstrap-made symlink to hosts/<role>/host.jsonc). Keys defined
    // here win over the include, so keep those two OUT of this file.
    // Module definitions below are shared even when only one host lists
    // them (battery, custom/dropbox, custom/vm) — unlisted modules are inert.
    "include": "$HOME/.config/waybar/host.jsonc",

    "layer": "top",
    "position": "top",
    "height": 34,
    "spacing": 8,

    "modules-left": ["hyprland/workspaces", "hyprland/window"],
    "modules-center": ["clock"],

    "clock": {
        "format": "{:%a %b %d  %I:%M %p}",
        "format-alt": "{:%A, %B %d, %Y  %I:%M:%S %p}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            "weeks-pos": "right",
            "on-scroll": 1,
            "format": {
                "months": "<span color='#66a0c8'><b>{}</b></span>",
                "weekdays": "<span color='#eccb60'><b>{}</b></span>",
                "weeks": "<span color='#878580'>W{}</span>",
                "today": "<span color='#100f0f' background='#66a0c8'><b><u>{}</u></b></span>"
            }
        }
    },

    "hyprland/window": {
        "format": "{class}",
        "max-length": 50,
        "separate-outputs": true,
        "rewrite": {
            "kitty": "\uf120 Kitty",
            "firefox": "\uf269 Firefox",
            "chromium": "\uf268 Chromium",
            "google-chrome": "\uf268 Chrome",
            "discord": "󰙯 Discord",
            "vesktop": "󰙯 Vesktop",
            "spotify": "\uf1bc Spotify",
            "code": "󰨞 Code",
            "thunar": "\uf07b Files",
            "steam": "\uf1b6 Steam",
            "com.moonlight_stream.Moonlight": "\udb82\udcb9 Moonlight",
            "teams-for-linux": "\udb80\udebb Teams",
            "obsidian": "󱓧 Obsidian",
            "unity": "󰛓 Unity",
            "blender": "󰂫 Blender",
            "(.*)": "$1"
        }
    },

    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-muted": "\udb81\udd81  muted",
        "format-icons": {
            "headphone": "\uf025",
            "hands-free": "\uf025",
            "headset": "\uf025",
            "phone": "\uf095",
            "portable": "\uf095",
            "car": "\uf1b9",
            "default": ["\uf026", "\uf027", "\uf028"]
        },
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-click-right": "pavucontrol",
        "scroll-step": 5
    },

    "network": {
        "interval": 2,
        "format-ethernet": "\udb80\ude00  {ipaddr}  ↓{bandwidthDownBits} ↑{bandwidthUpBits}",
        "format-wifi": "\uf1eb  {signalStrength}%  ↓{bandwidthDownBits} ↑{bandwidthUpBits}",
        "format-disconnected": "\udb83\udc9b  disconnected",
        "tooltip-format": "{ifname}: {ipaddr}/{cidr}\n{bandwidthUpBits} up / {bandwidthDownBits} down"
    },

    "cpu": {
        "format": "\uf4bc  {usage}%",
        "interval": 1,
        "on-click": "kitty -e btop"
    },

    "memory": {
        "format": "\udb80\udf5b  {percentage}%",
        "interval": 2,
        "on-click": "kitty -e btop",
        "tooltip-format": "{used:0.1f}G / {total:0.1f}G"
    },

    "custom/dropbox": {
        "exec": "~/.config/waybar/scripts/dropbox-status.sh",
        "return-type": "json",
        "interval": 10,
        "on-click": "kitty -e yazi ~/Dropbox",
        "on-click-right": "systemctl --user restart rclone-dropbox.service"
    },

    "custom/vm": {
        "exec": "~/.config/waybar/scripts/vm-status.sh rocky-maya",
        "return-type": "json",
        "interval": 5,
        "on-click": "virsh -c qemu:///system domstate rocky-maya | grep -q running || virsh -c qemu:///system start rocky-maya; virt-manager --connect qemu:///system --show-domain-console rocky-maya",
        "on-click-right": "virt-manager --connect qemu:///system"
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": "\udb80\udc84 {capacity}%",
        "format-plugged": "\uf1e6 {capacity}%",
        "format-icons": ["\uf244", "\uf243", "\uf242", "\uf241", "\uf240"]
    },

    "tray": {
        "icon-size": 16,
        "spacing": 8
    }
}
